<section
  class="mb-10 rounded-xl border border-slate-700 bg-slate-800 p-5"
  aria-labelledby="weather-heading"
  data-testid="weather-widget"
>
  <h2 id="weather-heading" class="mb-2 text-xl font-semibold text-slate-100">
    Weather near you
  </h2>
  <p class="mb-4 text-sm text-slate-300">
    Check current conditions for your location. Your location is used only to
    look up the weather and is not saved.
  </p>
  <button
    class="rounded-lg bg-blue-700 px-4 py-2 font-medium text-white hover:bg-blue-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-300 disabled:cursor-wait disabled:opacity-70"
    type="button"
    data-testid="weather-locate"
  >
    Use my location
  </button>
  <p
    class="mt-3 text-sm text-slate-300"
    role="status"
    aria-live="polite"
    aria-atomic="true"
    data-testid="weather-status"
  >
    Choose “Use my location” to allow location access and load the weather.
  </p>
  <p
    class="mt-3 text-lg font-medium text-slate-100"
    hidden
    data-testid="weather-result"
  >
  </p>
  <p class="mt-3 text-xs text-slate-400">
    Weather data by <a
      class="underline hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-300"
      href="https://open-meteo.com/"
      target="_blank"
      rel="noreferrer"
    >Open-Meteo</a>.
  </p>
</section>

<script>
  import { getCurrentWeather } from '../lib/weather';

  const button = document.querySelector<HTMLButtonElement>(
    '[data-testid="weather-locate"]',
  );
  const status = document.querySelector<HTMLElement>(
    '[data-testid="weather-status"]',
  );
  const result = document.querySelector<HTMLElement>(
    '[data-testid="weather-result"]',
  );

  if (!button || !status || !result) {
    throw new Error('Weather widget elements are missing.');
  }

  function getLocationErrorMessage(error: unknown): string {
    if (typeof error === 'object' && error !== null && 'code' in error) {
      if (error.code === 1) {
        return 'Location access was denied. Allow location access in your browser settings and try again.';
      }
      if (error.code === 2) {
        return 'Your location could not be determined. Check your device settings and try again.';
      }
      if (error.code === 3) {
        return 'Location lookup timed out. Please try again.';
      }
    }
    if (error instanceof Error && error.message === 'LOCATION_UNAVAILABLE') {
      return 'Location access is not available in this browser.';
    }
    return 'Weather could not be loaded right now. Please try again.';
  }

  button.addEventListener('click', async () => {
    button.disabled = true;
    status.textContent = 'Waiting for location permission...';
    result.hidden = true;

    try {
      if (!navigator.geolocation) {
        throw new Error('LOCATION_UNAVAILABLE');
      }

      const position = await new Promise<GeolocationPosition>(
        (resolve, reject) => {
          navigator.geolocation.getCurrentPosition(resolve, reject, {
            enableHighAccuracy: false,
            maximumAge: 300000,
            timeout: 10000,
          });
        },
      );

      status.textContent = 'Loading current weather...';
      const weather = await getCurrentWeather(
        position.coords.latitude,
        position.coords.longitude,
      );
      result.textContent = `${Math.round(weather.temperatureCelsius)} °C · ${weather.description}`;
      result.hidden = false;
      status.textContent = 'Current weather for your location:';
    } catch (error) {
      status.textContent = getLocationErrorMessage(error);
    } finally {
      button.disabled = false;
    }
  });
</script>
